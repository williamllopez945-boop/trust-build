{
  "name": "familyvault",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, privacy-first family estate and trust planning workspace. Not legal advice.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "privacy-scan": "node scripts/privacy-scan.mjs",
    "packet": "node --experimental-strip-types scripts/generate-packet.ts",
    "setup-hooks": "git config core.hooksPath .githooks",
    "check": "npm run privacy-scan && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
