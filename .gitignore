# ---------------------------------------------------------------------------
# FamilyVault: real family data never goes in Git.
# ---------------------------------------------------------------------------

# Real-data folders: only their README.md is tracked.
/estate/*
!/estate/README.md
/assets/*
!/assets/README.md
/trust/*
!/trust/README.md
/funding/*
!/funding/README.md
/audit/*
!/audit/README.md
/documents/*/*
!/documents/*/README.md

# Exports and vault backups
attorney-packet-*.md
*.vault
*.enc
*household*.json
!/schemas/*.schema.json
real-data/
private/
secrets/

# Documents, scans, images
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.jpg
*.jpeg
*.png
*.heic
*.tif
*.tiff
*.zip

# Secrets and local environment
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.kdbx
.privacy-denylist

# Build / dependencies
node_modules/
dist/
coverage/
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
