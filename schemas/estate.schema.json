{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familyvault.local/schemas/estate.schema.json",
  "title": "FamilyVault Household",
  "description": "Top-level shape of a household export. The TypeScript types in src/domain/types.ts are the source of truth; this schema documents the exchange format for tooling. Exports of real households must never be committed.",
  "type": "object",
  "required": ["id", "label", "isFictional", "maritalStatus", "people", "relationships", "fiduciaries", "assets", "plan", "decisions", "audit"],
  "$defs": {
    "status": { "enum": ["known", "confirmed", "unknown", "needs_review", "attorney_required"] },
    "tracked": {
      "type": "object",
      "required": ["value", "status"],
      "properties": { "value": {}, "status": { "$ref": "#/$defs/status" }, "note": { "type": "string" } }
    }
  },
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "isFictional": { "type": "boolean" },
    "maritalStatus": { "$ref": "#/$defs/tracked" },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "displayName"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["person", "trust", "charity", "entity"] },
          "displayName": { "type": "string" },
          "isMinor": { "type": "boolean" },
          "isGrantor": { "type": "boolean" }
        }
      }
    },
    "relationships": { "type": "array" },
    "fiduciaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "personId", "role", "order", "status"],
        "properties": {
          "role": { "enum": ["trustee", "successor_trustee", "guardian_of_person", "guardian_of_estate", "executor", "financial_agent", "healthcare_agent"] },
          "status": { "$ref": "#/$defs/status" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "category", "titledTo", "funding"],
        "properties": {
          "category": { "enum": ["real_estate", "bank", "brokerage", "business_interest", "vehicle", "personal_property", "digital", "ira", "401k", "tsp", "life_insurance", "annuity", "hsa"] },
          "refLast4": { "type": "string", "pattern": "^[0-9]{0,4}$" },
          "funding": {
            "type": "object",
            "required": ["method", "state"],
            "properties": {
              "method": { "enum": ["deed", "retitle", "assignment", "beneficiary_designation", "leave_outside", "instructions", "undecided"] },
              "state": { "enum": ["funded", "in_progress", "not_started", "review", "designation_current", "designation_needs_update", "left_outside", "instructions_missing"] }
            }
          }
        }
      }
    },
    "plan": { "type": "object", "required": ["name", "jurisdiction", "type", "distributions", "documents"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "sensitivity", "answer", "answeredBy", "state"],
        "properties": {
          "sensitivity": { "enum": ["factual", "important_fact", "dispositive", "fiduciary", "legal_tax"] },
          "answeredBy": { "enum": ["user", "assistant"] },
          "state": { "enum": ["proposed", "recorded", "confirmed", "awaiting_professional_review", "professionally_reviewed", "superseded"] }
        }
      }
    },
    "audit": { "type": "array" }
  }
}
